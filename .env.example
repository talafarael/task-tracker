# Ports exposed on the host as 127.0.0.1:<port> — point your reverse-proxy nginx at these.
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Base URL the built frontend uses to call the API. With backend proxied under
# https://your-domain/api, keep the default "/api" (same-origin, no CORS needed).
# VITE_API_URL=/api
