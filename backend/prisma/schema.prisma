// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  email         String         @unique
  name          String?
  password      String
  refreshToken  String?
  points        Int            @default(0)
  taskTemplates TaskTemplate[]
  tasks         Task[]
  dayNotes      DayNote[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TaskType {
  RECURRING
  // A task tied to a date range rather than a weekly schedule. It has a
  // single Task instance (and therefore a single shared status) shown on
  // every day within [startDate, endDate] — completing it on any one day
  // completes it everywhere in the range.
  PERIOD
}

// A recurring or period task definition. Does not itself get shown/checked
// off — concrete Task instances are spawned from it on demand.
model TaskTemplate {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  type        TaskType    @default(RECURRING)
  points      Int         @default(10)
  isRequired  Boolean     @default(false)
  repeatDays  DayOfWeek[]
  // Date range (PERIOD only). Normalized on create/update so both are
  // always set: startDate defaults to today, endDate defaults to startDate.
  startDate   String?
  endDate     String?
  tasks       Task[]
  user        User        @relation(fields: [userId], references: [id])
  userId      String      @db.ObjectId
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// A concrete occurrence of a TaskTemplate. RECURRING templates get one Task
// per matching day, spawned lazily the first time that day is viewed. PERIOD
// templates get exactly one Task for their whole [startDate, endDate] range,
// spawned once when the template is created — its `date` field is just the
// range's anchor (startDate), not a per-day marker.
model Task {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  date       String
  status     TaskStatus   @default(TODO)
  template   TaskTemplate @relation(fields: [templateId], references: [id])
  templateId String       @db.ObjectId
  user       User         @relation(fields: [userId], references: [id])
  userId     String       @db.ObjectId
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([templateId, date])
}

// Free-form text notes for a single day.
model DayNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      String
  text      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}
